# Generate two independent keys: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUDIT_WRITE_KEY=REPLACE_WITH_RANDOM_32_BYTE_SECRET
AUDIT_READ_KEY=REPLACE_WITH_ANOTHER_RANDOM_32_BYTE_SECRET
AUDIT_WRITE_SERVICE=demo-api
AUDIT_DB_PATH=./data/audit.sqlite
AUDIT_HOST=127.0.0.1
AUDIT_PORT=3000

# Hard limit on append-only events; back up and rotate to a new archive deliberately.
AUDIT_MAX_EVENTS=100000
# Optional: independently trusted, immutable checkpoint (read-only mounted).
# AUDIT_TRUSTED_CHECKPOINT_PATH=/secure-external/checkpoint.json
